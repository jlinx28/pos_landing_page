# Origin of the admin API (Next.js app at admin/) without trailing slash.
# Local dev:    http://localhost:3000
# Production:   https://pos.jeritools.com
#
# When unset, the landing page falls back to the hardcoded default
# testimonials/FAQs and the Contact form will fail to submit.
VITE_ADMIN_API=https://pos.jeritools.com
